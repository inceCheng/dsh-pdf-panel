{
  "name": "dsh-pdf-panel",
  "version": "0.1.0",
  "description": "Right-sidebar PDF reader for DeepSeek Harness: drop a PDF, select text, right-click \u89e3\u8bfb / \u7ffb\u8bd1 to send the passage and a ready prompt into the chat composer.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs",
    "assets",
    "locale",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "icon": "./assets/icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.0 <0.3.0",
    "node": ">=22"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "pdf",
    "pdf-reader",
    "sidebar",
    "translate",
    "right-click"
  ],
  "license": "MIT",
  "author": "inceCheng (https://github.com/inceCheng)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inceCheng/dsh-pdf-panel.git"
  },
  "homepage": "https://github.com/inceCheng/dsh-pdf-panel#readme",
  "bugs": {
    "url": "https://github.com/inceCheng/dsh-pdf-panel/issues"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run build && npm run typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.25.0",
    "pdfjs-dist": "6.3.289",
    "react": "18.3.1",
    "typescript": "^5.9.0"
  }
}
